# ==============================================================================
# AUTOBLOGGER AI - Cloud Run Backend Environment Variables
# Copy to .env for local development. In Cloud Run, set these via Secret Manager
# or Cloud Run Environment Variables — NEVER commit real secrets to GitHub.
# ==============================================================================

# Server & Runtime
NODE_ENV=production
PORT=8080
SERVICE_NAME=autoblogger-ai-backend
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=*

# Security & Authentication
# Required: Secret API key used by the Android app (X-API-Key header) when Firebase ID token is not used.
BACKEND_API_SECRET=change-this-to-a-strong-random-32-char-secret
# Shared secret for Google Cloud Scheduler & Cloud Tasks callbacks (X-Scheduler-Secret header)
SCHEDULER_SHARED_SECRET=change-this-to-another-strong-random-secret
# Set to true to allow X-API-Key auth in addition to Firebase Auth Bearer tokens
ALLOW_API_KEY_AUTH=true

# Google Cloud & Firebase
# On Cloud Run, Application Default Credentials (ADC) are used automatically.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1
FIREBASE_PROJECT_ID=your-firebase-project-id
FIRESTORE_DATABASE_ID=(default)
# Optional for non-GCP local environments only: raw JSON string of service account key
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Cloud Tasks (Persistent Async Execution)
CLOUD_TASKS_ENABLED=false
CLOUD_TASKS_LOCATION=asia-south1
CLOUD_TASKS_QUEUE=autoblogger-tasks
# Deployed Cloud Run HTTPS URL (e.g. https://autoblogger-backend-xxxxx-el.a.run.app)
CLOUD_RUN_SERVICE_URL=
# Service account email used by Cloud Tasks to sign OIDC tokens when calling Cloud Run
CLOUD_TASKS_INVOKER_SA_EMAIL=

# AI Providers & Failover Order
# Comma-separated priority: gemini,openrouter,apinex,custom
AI_PROVIDER_ORDER=gemini,openrouter,apinex,custom
AI_CIRCUIT_BREAKER_THRESHOLD=3
AI_CIRCUIT_BREAKER_COOLDOWN_MS=120000

# 1. Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# 2. OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=https://autoblogger.local
OPENROUTER_APP_NAME=AUTOBLOGGER AI

# 3. API-NEX (OpenAI-compatible)
APINEX_API_KEY=
APINEX_BASE_URL=https://api.apinex.io/v1
APINEX_MODEL=gpt-4o-mini

# 4. Custom OpenAI-Compatible Provider
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=

# Google OAuth2 (Used for Blogger API, Search Console API, GA4 Data API)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Blogger Default Blog ID (can also be passed per campaign/request)
DEFAULT_BLOGGER_BLOG_ID=

# Google Search Console & Google Analytics 4
GSC_SITE_URL=
GA4_PROPERTY_ID=

# Adsterra Publisher API
ADSTERRA_API_KEY=
ADSTERRA_BASE_URL=https://api3.adsterratools.com/publisher
