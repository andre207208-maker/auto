{
  "name": "autoblogger-ai-backend",
  "version": "2.0.0",
  "description": "Cloudflare Workers + D1 + Queues + Cron Triggers + R2 backend for AUTOBLOGGER AI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "check": "npm run lint && npm run test"
  },
  "dependencies": {
    "hono": "^4.7.10",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250425.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "wrangler": "^4.14.1"
  }
}
